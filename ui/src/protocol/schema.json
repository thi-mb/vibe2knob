{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Vibe2knobProtocol",
  "description": "vibe2knob hub protocol v1",
  "type": "object",
  "properties": {
    "client": {
      "$ref": "#/$defs/ClientEnvelope"
    },
    "hub": {
      "$ref": "#/$defs/HubEnvelope"
    }
  },
  "$defs": {
    "ChatChanged": {
      "additionalProperties": false,
      "properties": {
        "v": {
          "const": 1,
          "default": 1,
          "description": "Protocol version.",
          "type": "integer"
        },
        "type": {
          "const": "chat.changed",
          "default": "chat.changed",
          "type": "string"
        },
        "request_id": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        },
        "chat": {
          "$ref": "#/$defs/ChatSummary"
        }
      },
      "required": [
        "v",
        "type",
        "request_id",
        "chat"
      ],
      "title": "ChatChanged",
      "type": "object"
    },
    "ChatClose": {
      "additionalProperties": false,
      "properties": {
        "v": {
          "const": 1,
          "default": 1,
          "description": "Protocol version.",
          "type": "integer"
        },
        "request_id": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "Set by the client; echoed on the hub's reply or error."
        },
        "type": {
          "const": "chat.close",
          "default": "chat.close",
          "type": "string"
        },
        "chat_id": {
          "type": "string"
        }
      },
      "required": [
        "type",
        "chat_id"
      ],
      "title": "ChatClose",
      "type": "object"
    },
    "ChatClosed": {
      "additionalProperties": false,
      "properties": {
        "v": {
          "const": 1,
          "default": 1,
          "description": "Protocol version.",
          "type": "integer"
        },
        "type": {
          "const": "chat.closed",
          "default": "chat.closed",
          "type": "string"
        },
        "request_id": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        },
        "chat_id": {
          "type": "string"
        }
      },
      "required": [
        "v",
        "type",
        "request_id",
        "chat_id"
      ],
      "title": "ChatClosed",
      "type": "object"
    },
    "ChatCreate": {
      "additionalProperties": false,
      "properties": {
        "v": {
          "const": 1,
          "default": 1,
          "description": "Protocol version.",
          "type": "integer"
        },
        "request_id": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "Set by the client; echoed on the hub's reply or error."
        },
        "type": {
          "const": "chat.create",
          "default": "chat.create",
          "type": "string"
        },
        "context": {
          "$ref": "#/$defs/ContextSetInput"
        }
      },
      "title": "ChatCreate",
      "type": "object",
      "required": [
        "type"
      ]
    },
    "ChatDelta": {
      "additionalProperties": false,
      "description": "A piece of the assistant's prose, streamed as it is written.",
      "properties": {
        "v": {
          "const": 1,
          "default": 1,
          "description": "Protocol version.",
          "type": "integer"
        },
        "type": {
          "const": "chat.delta",
          "default": "chat.delta",
          "type": "string"
        },
        "chat_id": {
          "type": "string"
        },
        "turn_id": {
          "type": "string"
        },
        "text": {
          "type": "string"
        }
      },
      "required": [
        "v",
        "type",
        "chat_id",
        "turn_id",
        "text"
      ],
      "title": "ChatDelta",
      "type": "object"
    },
    "ChatDone": {
      "additionalProperties": false,
      "properties": {
        "v": {
          "const": 1,
          "default": 1,
          "description": "Protocol version.",
          "type": "integer"
        },
        "type": {
          "const": "chat.done",
          "default": "chat.done",
          "type": "string"
        },
        "chat_id": {
          "type": "string"
        },
        "turn_id": {
          "type": "string"
        },
        "usage": {
          "anyOf": [
            {
              "$ref": "#/$defs/Usage"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "What the turn used, if it got that far."
        }
      },
      "required": [
        "v",
        "type",
        "chat_id",
        "turn_id",
        "usage"
      ],
      "title": "ChatDone",
      "type": "object"
    },
    "ChatHistory": {
      "additionalProperties": false,
      "description": "A chat's turns, oldest first, in answer to chat.open.",
      "properties": {
        "v": {
          "const": 1,
          "default": 1,
          "description": "Protocol version.",
          "type": "integer"
        },
        "type": {
          "const": "chat.history",
          "default": "chat.history",
          "type": "string"
        },
        "request_id": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        },
        "chat_id": {
          "type": "string"
        },
        "turns": {
          "items": {
            "$ref": "#/$defs/ChatTurn"
          },
          "type": "array"
        }
      },
      "required": [
        "v",
        "type",
        "request_id",
        "chat_id",
        "turns"
      ],
      "title": "ChatHistory",
      "type": "object"
    },
    "ChatOpen": {
      "additionalProperties": false,
      "description": "Ask for a chat's turns, e.g. when a tab is shown after a reload or reconnect.",
      "properties": {
        "v": {
          "const": 1,
          "default": 1,
          "description": "Protocol version.",
          "type": "integer"
        },
        "request_id": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "Set by the client; echoed on the hub's reply or error."
        },
        "type": {
          "const": "chat.open",
          "default": "chat.open",
          "type": "string"
        },
        "chat_id": {
          "type": "string"
        }
      },
      "required": [
        "type",
        "chat_id"
      ],
      "title": "ChatOpen",
      "type": "object"
    },
    "ChatSend": {
      "additionalProperties": false,
      "properties": {
        "v": {
          "const": 1,
          "default": 1,
          "description": "Protocol version.",
          "type": "integer"
        },
        "request_id": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "Set by the client; echoed on the hub's reply or error."
        },
        "type": {
          "const": "chat.send",
          "default": "chat.send",
          "type": "string"
        },
        "chat_id": {
          "type": "string"
        },
        "text": {
          "type": "string"
        }
      },
      "required": [
        "type",
        "chat_id",
        "text"
      ],
      "title": "ChatSend",
      "type": "object"
    },
    "ChatSteps": {
      "additionalProperties": false,
      "description": "The steps the model suggested. Optional: a prose-only answer sends none.",
      "properties": {
        "v": {
          "const": 1,
          "default": 1,
          "description": "Protocol version.",
          "type": "integer"
        },
        "type": {
          "const": "chat.steps",
          "default": "chat.steps",
          "type": "string"
        },
        "chat_id": {
          "type": "string"
        },
        "turn_id": {
          "type": "string"
        },
        "steps": {
          "items": {
            "$ref": "#/$defs/Step"
          },
          "type": "array"
        },
        "listen_for": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        },
        "caution": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        },
        "warnings": {
          "items": {
            "type": "string"
          },
          "type": "array"
        }
      },
      "required": [
        "v",
        "type",
        "chat_id",
        "turn_id",
        "steps",
        "listen_for",
        "caution",
        "warnings"
      ],
      "title": "ChatSteps",
      "type": "object"
    },
    "ChatSummary": {
      "description": "A chat as a tab shows it.",
      "properties": {
        "id": {
          "type": "string"
        },
        "title": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "Topic title; null until named."
        },
        "context": {
          "$ref": "#/$defs/ContextSet"
        },
        "updated_at": {
          "description": "ISO 8601 time of the last change.",
          "type": "string"
        },
        "usage": {
          "anyOf": [
            {
              "$ref": "#/$defs/Usage"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "Everything the chat used, titles included. Its model is the answers' model."
        },
        "title_usage": {
          "anyOf": [
            {
              "$ref": "#/$defs/Usage"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "What naming the chat used."
        },
        "context_tokens": {
          "anyOf": [
            {
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "Tokens the next message resends: the last answer's prompt plus its output."
        },
        "context_window": {
          "anyOf": [
            {
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "The model's context window."
        }
      },
      "required": [
        "id",
        "title",
        "context",
        "updated_at",
        "usage",
        "title_usage",
        "context_tokens",
        "context_window"
      ],
      "title": "ChatSummary",
      "type": "object"
    },
    "ChatTurn": {
      "description": "One turn of a saved chat, as chat.history replays it.",
      "properties": {
        "id": {
          "description": "For an assistant turn, the turn_id its deltas carried.",
          "type": "string"
        },
        "role": {
          "enum": [
            "user",
            "assistant"
          ],
          "type": "string"
        },
        "text": {
          "type": "string"
        },
        "created_at": {
          "description": "ISO 8601 time the turn started.",
          "type": "string"
        },
        "steps": {
          "anyOf": [
            {
              "items": {
                "$ref": "#/$defs/Step"
              },
              "type": "array"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "Null when no steps were suggested."
        },
        "listen_for": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        },
        "caution": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        },
        "warnings": {
          "items": {
            "type": "string"
          },
          "type": "array"
        },
        "error": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "Why the turn failed, if it did."
        },
        "usage": {
          "anyOf": [
            {
              "$ref": "#/$defs/Usage"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "Set on assistant turns."
        }
      },
      "required": [
        "id",
        "role",
        "text",
        "created_at",
        "steps",
        "listen_for",
        "caution",
        "warnings",
        "error",
        "usage"
      ],
      "title": "ChatTurn",
      "type": "object"
    },
    "ChatUpdate": {
      "additionalProperties": false,
      "properties": {
        "v": {
          "const": 1,
          "default": 1,
          "description": "Protocol version.",
          "type": "integer"
        },
        "request_id": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "Set by the client; echoed on the hub's reply or error."
        },
        "type": {
          "const": "chat.update",
          "default": "chat.update",
          "type": "string"
        },
        "chat_id": {
          "type": "string"
        },
        "title": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        },
        "context": {
          "anyOf": [
            {
              "$ref": "#/$defs/ContextSetInput"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        }
      },
      "required": [
        "type",
        "chat_id"
      ],
      "title": "ChatUpdate",
      "type": "object"
    },
    "ClientEnvelope": {
      "description": "Any message a client may send.",
      "discriminator": {
        "mapping": {
          "chat.close": "#/$defs/ChatClose",
          "chat.create": "#/$defs/ChatCreate",
          "chat.open": "#/$defs/ChatOpen",
          "chat.send": "#/$defs/ChatSend",
          "chat.update": "#/$defs/ChatUpdate",
          "hello": "#/$defs/Hello",
          "live.use_example": "#/$defs/LiveUseExample",
          "settings.test": "#/$defs/SettingsTest",
          "settings.update": "#/$defs/SettingsUpdate",
          "tracks.list": "#/$defs/TracksList",
          "usage.get": "#/$defs/UsageGet"
        },
        "propertyName": "type"
      },
      "oneOf": [
        {
          "$ref": "#/$defs/Hello"
        },
        {
          "$ref": "#/$defs/ChatCreate"
        },
        {
          "$ref": "#/$defs/ChatSend"
        },
        {
          "$ref": "#/$defs/ChatUpdate"
        },
        {
          "$ref": "#/$defs/ChatOpen"
        },
        {
          "$ref": "#/$defs/ChatClose"
        },
        {
          "$ref": "#/$defs/TracksList"
        },
        {
          "$ref": "#/$defs/SettingsUpdate"
        },
        {
          "$ref": "#/$defs/SettingsTest"
        },
        {
          "$ref": "#/$defs/LiveUseExample"
        },
        {
          "$ref": "#/$defs/UsageGet"
        }
      ],
      "title": "ClientEnvelope"
    },
    "ContextSet": {
      "description": "What a chat looks at, besides the light session summary it always gets.",
      "properties": {
        "follow_selection": {
          "default": true,
          "description": "Include whichever track is selected in Live.",
          "type": "boolean"
        },
        "pinned": {
          "description": "Track indexes pinned with @.",
          "items": {
            "type": "integer"
          },
          "type": "array"
        }
      },
      "required": [
        "follow_selection",
        "pinned"
      ],
      "title": "ContextSet",
      "type": "object"
    },
    "ContextSetInput": {
      "description": "What a chat looks at, besides the light session summary it always gets.",
      "properties": {
        "follow_selection": {
          "default": true,
          "description": "Include whichever track is selected in Live.",
          "type": "boolean"
        },
        "pinned": {
          "description": "Track indexes pinned with @.",
          "items": {
            "type": "integer"
          },
          "type": "array"
        }
      },
      "title": "ContextSetInput",
      "type": "object"
    },
    "ErrorMessage": {
      "additionalProperties": false,
      "properties": {
        "v": {
          "const": 1,
          "default": 1,
          "description": "Protocol version.",
          "type": "integer"
        },
        "type": {
          "const": "error",
          "default": "error",
          "type": "string"
        },
        "request_id": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        },
        "code": {
          "enum": [
            "bad_request",
            "unsupported_version",
            "not_found",
            "provider",
            "live",
            "internal"
          ],
          "type": "string"
        },
        "message": {
          "type": "string"
        },
        "chat_id": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "Set when a chat's turn failed."
        },
        "turn_id": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "The failed turn; chat.done for it follows."
        }
      },
      "required": [
        "v",
        "type",
        "request_id",
        "code",
        "message",
        "chat_id",
        "turn_id"
      ],
      "title": "ErrorMessage",
      "type": "object"
    },
    "Hello": {
      "additionalProperties": false,
      "properties": {
        "v": {
          "const": 1,
          "default": 1,
          "description": "Protocol version.",
          "type": "integer"
        },
        "request_id": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "Set by the client; echoed on the hub's reply or error."
        },
        "type": {
          "const": "hello",
          "default": "hello",
          "type": "string"
        },
        "client": {
          "enum": [
            "panel",
            "browser",
            "phone"
          ],
          "type": "string"
        }
      },
      "required": [
        "type",
        "client"
      ],
      "title": "Hello",
      "type": "object"
    },
    "HubEnvelope": {
      "description": "Any message the hub may send.",
      "discriminator": {
        "mapping": {
          "chat.changed": "#/$defs/ChatChanged",
          "chat.closed": "#/$defs/ChatClosed",
          "chat.delta": "#/$defs/ChatDelta",
          "chat.done": "#/$defs/ChatDone",
          "chat.history": "#/$defs/ChatHistory",
          "chat.steps": "#/$defs/ChatSteps",
          "error": "#/$defs/ErrorMessage",
          "live.status": "#/$defs/LiveStatusChanged",
          "settings": "#/$defs/SettingsChanged",
          "tracks": "#/$defs/Tracks",
          "usage.report": "#/$defs/UsageReport",
          "welcome": "#/$defs/Welcome"
        },
        "propertyName": "type"
      },
      "oneOf": [
        {
          "$ref": "#/$defs/Welcome"
        },
        {
          "$ref": "#/$defs/LiveStatusChanged"
        },
        {
          "$ref": "#/$defs/Tracks"
        },
        {
          "$ref": "#/$defs/ChatChanged"
        },
        {
          "$ref": "#/$defs/ChatClosed"
        },
        {
          "$ref": "#/$defs/ChatHistory"
        },
        {
          "$ref": "#/$defs/ChatDelta"
        },
        {
          "$ref": "#/$defs/ChatSteps"
        },
        {
          "$ref": "#/$defs/ChatDone"
        },
        {
          "$ref": "#/$defs/SettingsChanged"
        },
        {
          "$ref": "#/$defs/UsageReport"
        },
        {
          "$ref": "#/$defs/ErrorMessage"
        }
      ],
      "title": "HubEnvelope"
    },
    "LiveStatus": {
      "properties": {
        "connected": {
          "type": "boolean"
        },
        "selected_track": {
          "anyOf": [
            {
              "$ref": "#/$defs/TrackRef"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        },
        "detail": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "Why Live isn't reachable, if it isn't."
        },
        "example": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "Name of the example track in use instead of Live, if any."
        }
      },
      "required": [
        "connected",
        "selected_track",
        "detail",
        "example"
      ],
      "title": "LiveStatus",
      "type": "object"
    },
    "LiveStatusChanged": {
      "additionalProperties": false,
      "description": "Sent when Live connects or disconnects, or the selected track changes.",
      "properties": {
        "v": {
          "const": 1,
          "default": 1,
          "description": "Protocol version.",
          "type": "integer"
        },
        "type": {
          "const": "live.status",
          "default": "live.status",
          "type": "string"
        },
        "live": {
          "$ref": "#/$defs/LiveStatus"
        }
      },
      "required": [
        "v",
        "type",
        "live"
      ],
      "title": "LiveStatusChanged",
      "type": "object"
    },
    "LiveUseExample": {
      "additionalProperties": false,
      "description": "Use an example track instead of Live (null goes back to Live). The hub answers with\nlive.status, so every client sees the switch.",
      "properties": {
        "v": {
          "const": 1,
          "default": 1,
          "description": "Protocol version.",
          "type": "integer"
        },
        "request_id": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "Set by the client; echoed on the hub's reply or error."
        },
        "type": {
          "const": "live.use_example",
          "default": "live.use_example",
          "type": "string"
        },
        "name": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "description": "One of welcome.examples' names, or null."
        }
      },
      "required": [
        "type",
        "name"
      ],
      "title": "LiveUseExample",
      "type": "object"
    },
    "Settings": {
