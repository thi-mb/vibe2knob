        },
        "track": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "Track the step is on, as named in the chat's context; null for the only track."
        },
        "device": {
          "description": "Exact name as listed on the chain, or the stock device name when adding one.",
          "type": "string"
        },
        "chain": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "Rack chain the device is in, or null."
        },
        "on_track": {
          "description": "True when the device is already on the track.",
          "type": "boolean"
        },
        "parameter": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "description": "Parameter as labelled in Live, or null."
        },
        "value_range": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "description": "Starting point, e.g. '120-140 %'."
        },
        "explanation": {
          "description": "What it does and why it fits, one or two sentences.",
          "type": "string"
        },
        "stock_device": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "Stock device this step uses; filled in by vibe2knob's checks."
        },
        "track_index": {
          "anyOf": [
            {
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "Live's index of the track the step is on; filled in by vibe2knob's checks, null when the track name is missing or matches more than one track."
        }
      },
      "required": [
        "action",
        "device",
        "on_track",
        "parameter",
        "value_range",
