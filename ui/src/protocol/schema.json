    "Usage": {
      "description": "Tokens used by one turn, one chat or a period. Counted on the hub, never sent anywhere.\n\ninput_tokens is the uncached input only: the whole prompt is input + cache_read +\ncache_write. thinking_tokens are part of output_tokens.",
      "properties": {
        "input_tokens": {
          "default": 0,
          "type": "integer"
        },
        "output_tokens": {
          "default": 0,
          "type": "integer"
        },
        "cache_read_tokens": {
          "default": 0,
          "type": "integer"
        },
        "cache_write_tokens": {
          "default": 0,
          "type": "integer"
        },
        "thinking_tokens": {
          "default": 0,
          "type": "integer"
        },
        "calls": {
          "default": 0,
          "description": "Model calls counted; each one resends the instructions.",
          "type": "integer"
        },
        "parts": {
          "additionalProperties": {
            "type": "integer"
          },
          "description": "Prompt and answer split into parts. Only instructions, tools and thinking are exact; the rest are estimates by text length.",
          "propertyNames": {
            "enum": [
              "instructions",
              "tools",
              "live",
              "history",
              "message",
              "thinking",
              "answer",
              "steps"
            ]
          },
          "type": "object"
        },
        "model": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "The model that answered; null if several."
        },
        "cost_usd": {
          "anyOf": [
            {
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "Estimated from the hub's price table; null if no price is known."
        },
        "cost_complete": {
          "default": true,
          "description": "False when some calls had no known price, so cost_usd is low.",
          "type": "boolean"
        },
        "prompt_cost_usd": {
          "anyOf": [
            {
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "The part of cost_usd spent on prompts (input and cache)."
        },
        "output_cost_usd": {
          "anyOf": [
            {
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "The part of cost_usd spent on output, thinking included."
        }
      },
      "required": [
        "input_tokens",
        "output_tokens",
        "cache_read_tokens",
        "cache_write_tokens",
        "thinking_tokens",
        "calls",
        "parts",
        "model",
        "cost_usd",
        "cost_complete",
        "prompt_cost_usd",
        "output_cost_usd"
      ],
      "title": "Usage",
      "type": "object"
    },
