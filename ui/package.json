{
  "name": "vibe2knob-ui",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "dev:fake": "VITE_FAKE_HUB=1 vite",
    "build": "tsc -b && vite build",
    "typecheck": "tsc -b",
    "test": "vitest run --dir src",
    "e2e": "playwright test",
    "gen:types": "python3 -m vibe2knob.protocol > src/protocol/schema.json && json2ts -i src/protocol/schema.json -o src/protocol/types.ts --unreachableDefinitions --no-additionalProperties --bannerComment \"/* Generated from src/vibe2knob/protocol.py by npm run gen:types. Do not edit. */\""
  },
  "dependencies": {
    "@fontsource/ibm-plex-mono": "^5.3.0",
    "@fontsource/ibm-plex-sans": "^5.3.0",
    "react": "^19.3.1",
    "react-dom": "^19.3.1"
  },
  "devDependencies": {
    "@playwright/test": "^1.64.1",
    "@types/node": "^22.20.5",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.2",
    "json-schema-to-typescript": "^16.0.0",
    "typescript": "^6.0.3",
    "vite": "^8.3.5",
    "vitest": "^5.0.5"
  }
}
